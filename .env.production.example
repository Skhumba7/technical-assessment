# ==============================================================================
# Production Environment Configuration Template
# Usage: Copy to .env.production and populate real secrets before deploying.
# Command: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ==============================================================================

# Application Exposure
HOST_HTTP_PORT=5000

# Database Configuration (PostgreSQL / AWS Aurora)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zapper_payments
DB_USER=zapper_prod
DB_PASSWORD=ReplaceWithStrongProdDbPassword_2026!
DB_SSL_MODE=Prefer

# Acme Pay Gateway Integration (Production Credentials)
ACME_BASE_URL=https://api.acmepay.com
ACME_API_KEY=sk_prod_live_key_replace_me
ACME_MERCHANT_ID=8B67BF88-BB8D-4EB5-ADFC-0F5C97C7ED67
ACME_TIMEOUT_SECONDS=15
ACME_ADVICE_USERNAME=acme_advice_prod_user
ACME_ADVICE_PASSWORD=ReplaceWithSecureAdvicePassword!
ACME_WEBHOOK_SECRET=ReplaceWithSecureHmacSha256SecretKey!
