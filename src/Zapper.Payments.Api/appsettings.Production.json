{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Zapper.Payments": "Information"
    }
  },
  "AllowedHosts": "*.zapper.com;*.zapper.co.za",
  "ConnectionStrings": {
    "DefaultConnection": "Host=aurora-pg-cluster.zapper.internal;Port=5432;Database=zapper_payments;Username=zapper_app;Password=${DB_PASSWORD};SslMode=Require;TrustServerCertificate=false;"
  },
  "Acme": {
    "BaseUrl": "https://api.acmepay.com",
    "ApiKey": "${ACME_API_KEY}",
    "MerchantId": "${ACME_MERCHANT_ID}",
    "TimeoutSeconds": 15,
    "AdviceUsername": "${ACME_ADVICE_USERNAME}",
    "AdvicePassword": "${ACME_ADVICE_PASSWORD}",
    "WebhookSecret": "${ACME_WEBHOOK_SECRET}"
  }
}
