{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Acme": {
    "ApiKey": "${ACME_API_KEY}",
    "MerchantId": "${ACME_MERCHANT_ID}",
    "AdviceUsername": "${ACME_ADVICE_USERNAME}",
    "AdvicePassword": "${ACME_ADVICE_PASSWORD}",
    "WebhookSecret": "${ACME_WEBHOOK_SECRET}"
  },
  "Zapper": {
    "AdviceUrl": "https://payments.zapper.com/api/v1/notifications/payment-advice",
    "SwitchWebhookUrl": "https://payments.zapper.com/api/v1/notifications/transaction-status"
  }
}
